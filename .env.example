# ============================================================
# .env.example — Template Konfigurasi Lingkungan MySQL
# Salin file ini menjadi .env dan sesuaikan dengan setup lokal.
# ============================================================

# --- Konfigurasi MySQL (XAMPP default) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=db_forecasting

# --- Konfigurasi Aplikasi ---
APP_ENV=development
LOG_LEVEL=INFO
